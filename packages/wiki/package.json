{
  "name": "@gw2kit/wiki",
  "version": "0.0.3",
  "description": "Guild Wars 2 wiki client: search, page text, Semantic MediaWiki queries, and typed Mystic Forge recipes and NPC vendor offers read from the wiki's structured data. Runs in Node and browsers.",
  "keywords": [
    "guild-wars-2",
    "gw2",
    "gw2-wiki",
    "mystic-forge",
    "semantic-mediawiki"
  ],
  "license": "MIT",
  "author": "Christopher Davenport",
  "homepage": "https://github.com/ChristopherDavenport/gw2-ai/tree/main/packages/wiki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopherDavenport/gw2-ai.git",
    "directory": "packages/wiki"
  },
  "bugs": {
    "url": "https://github.com/ChristopherDavenport/gw2-ai/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gw2kit/client": "workspace:*"
  }
}
