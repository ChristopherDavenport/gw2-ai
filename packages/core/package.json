{
  "name": "@gw2-ai/core",
  "version": "0.1.0",
  "description": "Account report sections, recipe trees and markdown helpers built on @gw2-ai/client.",
  "keywords": [
    "guild-wars-2",
    "gw2",
    "gw2-api",
    "markdown"
  ],
  "license": "MIT",
  "author": "Christopher Davenport",
  "homepage": "https://github.com/ChristopherDavenport/gw2-ai/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopherDavenport/gw2-ai.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ChristopherDavenport/gw2-ai/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gw2-ai/client": "workspace:*"
  }
}
