{
  "name": "@gw2-ai/core",
  "version": "0.0.2",
  "description": "Markdown for AI assistants built on @gw2kit: the Guild Wars 2 account report, character pages, recipe-tree rendering and formatting helpers.",
  "keywords": [
    "guild-wars-2",
    "gw2",
    "gw2-api",
    "markdown"
  ],
  "license": "MIT",
  "author": "Christopher Davenport",
  "homepage": "https://github.com/ChristopherDavenport/gw2-ai/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopherDavenport/gw2-ai.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ChristopherDavenport/gw2-ai/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plans": {
      "types": "./dist/plans.d.ts",
      "default": "./dist/plans.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gw2kit/client": "workspace:*",
    "@gw2kit/recipes": "workspace:*",
    "@gw2kit/wiki": "workspace:*"
  }
}
