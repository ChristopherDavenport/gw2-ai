{
  "name": "@gw2kit/recipes",
  "version": "0.1.0",
  "description": "Guild Wars 2 recipe trees: crafting, Mystic Forge and NPC vendor routes for any item, priced at the trading post, with buy-or-craft choices, holdings, and vendor costs in wallet currencies. Fetching and solving are separate, so trees can be solved offline from saved data.",
  "keywords": [
    "guild-wars-2",
    "gw2",
    "crafting",
    "mystic-forge",
    "recipes",
    "legendary"
  ],
  "license": "MIT",
  "author": "Christopher Davenport",
  "homepage": "https://github.com/ChristopherDavenport/gw2-ai/tree/main/packages/recipes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopherDavenport/gw2-ai.git",
    "directory": "packages/recipes"
  },
  "bugs": {
    "url": "https://github.com/ChristopherDavenport/gw2-ai/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gw2kit/client": "workspace:*",
    "@gw2kit/wiki": "workspace:*"
  }
}
